// REQUER: plugin streamer + #include <streamer> no gamemode principal
// Os objetos sao criados com CreateDynamicObject para respeitar os virtual worlds.
// Sem o streamer, os objetos NAO aparecerao.

// =============================================================================
// OBJETOS DOS MAPAS DE DERBY (extraido do SFRDERBY.pwn)
// Cada NewMap() incrementa o virtual world (50 + indice)
// =============================================================================

new DERBY_MAP_VW = 49; // incrementado por NewDerbyMap()

NewDerbyMap()
{
    DERBY_MAP_VW++;
    return 1;
}

CreateDerbyObj(modelid, Float:X, Float:Y, Float:Z, Float:RX, Float:RY, Float:RZ)
{
    // Cria o objeto apenas no virtual world do mapa atual
    // Usa CreateDynamicObject do plugin streamer (visivel apenas no VW correto)
    return CreateDynamicObject(modelid, X, Y, Z, RX, RY, RZ, DERBY_MAP_VW, -1, -1, 300.0, 300.0);
}

